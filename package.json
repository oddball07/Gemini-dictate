{
  "name": "gemini-dictate",
  "version": "1.1.0",
  "description": "Windows dictation widget that uses the Gemini website's own speech-to-text, with AI cleanup and a prompt mode.",
  "bin": {
    "dictate": "bin/dictate.js"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "pyproject.toml",
    "README.md",
    "!**/__pycache__"
  ],
  "keywords": [
    "dictation",
    "speech-to-text",
    "gemini",
    "voice",
    "windows",
    "prompt"
  ],
  "license": "MIT"
}
